{
  "name": "automated-phishing-domain-detector",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "backend:setup": "python3 -m venv .venv && .venv/bin/python -m pip install -r requirements.txt",
    "backend": ".venv/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000",
    "backend:test": ".venv/bin/python -m unittest discover -s backend/tests -v",
    "domains:refresh": ".venv/bin/python -m backend.scripts.refresh_live",
    "domains:check": ".venv/bin/python -m backend.scripts.refresh_live --source-only",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "vite": "^8.2.0"
  }
}
